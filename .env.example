# ==============================================================================
# GeoDemand AI — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LIVE DATA MODE
# ------------------------------------------------------------------------------
LIVE_MODE=true
ALLOW_SYNTHETIC_FALLBACK=true
SHOW_FALLBACK_WARNINGS=true
MAX_LIVE_DATA_AGE_SEC=1800

# ------------------------------------------------------------------------------
# PROVIDER SELECTION
# ------------------------------------------------------------------------------
WEATHER_PROVIDER=open_meteo
TRAFFIC_PROVIDER=auto
COMPETITION_PROVIDER=auto
EVENT_PROVIDER=auto
FUEL_PRICE_PROVIDER=manual

# ------------------------------------------------------------------------------
# TRAFFIC (Optional)
# ------------------------------------------------------------------------------
# Provider: HERE Technologies (https://developer.here.com/) - 250k free transactions/mo
HERE_API_KEY=
# Provider: TomTom (https://developer.tomtom.com/) - 2.5k free req/day
TOMTOM_API_KEY=

# ------------------------------------------------------------------------------
# COMPETITION / PLACES (Optional)
# ------------------------------------------------------------------------------
# Provider: Google Places API (https://console.cloud.google.com/) - $200 free credit/mo
GOOGLE_PLACES_API_KEY=
# Provider: Foursquare Places API (https://location.foursquare.com/developer/)
FOURSQUARE_API_KEY=

# ------------------------------------------------------------------------------
# EVENTS (Optional)
# ------------------------------------------------------------------------------
# Provider: Eventbrite API (https://www.eventbrite.com/platform/api)
EVENTBRITE_TOKEN=

# ------------------------------------------------------------------------------
# WEATHER
# ------------------------------------------------------------------------------
# Open-Meteo free API requires no key for non-commercial use.
# Current weather + hourly forecast supported.
WEATHER_CACHE_TTL_SEC=300

# ------------------------------------------------------------------------------
# CACHE TTLs (Seconds)
# ------------------------------------------------------------------------------
TRAFFIC_CACHE_TTL_SEC=120
COMPETITION_CACHE_TTL_SEC=1800
EVENTS_CACHE_TTL_SEC=900
OSM_CACHE_TTL_SEC=86400
FUEL_PRICE_CACHE_TTL_SEC=86400
HOLIDAY_CACHE_TTL_SEC=604800

# ------------------------------------------------------------------------------
# FUEL & ECONOMICS
# ------------------------------------------------------------------------------
FUEL_PRICE_INR_PER_LITRE=95.0
FUEL_PRICE_SOURCE=manual_fallback
FUEL_PRICE_EFFECTIVE_DATE=2026-08-18
FUEL_EFFICIENCY_KM_PER_L=18.0

# ------------------------------------------------------------------------------
# SPATIAL & RECOMMENDATION DEFAULTS
# ------------------------------------------------------------------------------
SEARCH_RADIUS_KM=2.0
TOP_N=5
MAX_CANDIDATES=50
AVG_URBAN_SPEED_KMH=20.0

# ------------------------------------------------------------------------------
# BUSINESS DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_AOV_INR=100.0
DEFAULT_VARIABLE_COST_RATE=0.38
DEFAULT_FIXED_COST_PER_DAY_INR=500.0

# ------------------------------------------------------------------------------
# STRATEGIC DECISION POLICY THRESHOLDS (INR/hour)
# ------------------------------------------------------------------------------
# Minimum hourly profit improvement required to recommend moving
STAY_THRESHOLD_INR_PER_HOUR=50.0
# Profit improvement threshold for strong move vs marginal consideration
CONSIDER_MOVE_THRESHOLD_INR_PER_HOUR=250.0