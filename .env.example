# ==============================================================================
# GeoDemand AI — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LIVE DATA MODE
# ------------------------------------------------------------------------------
LIVE_MODE=true
ALLOW_SYNTHETIC_FALLBACK=true
SHOW_FALLBACK_WARNINGS=true
MAX_LIVE_DATA_AGE_SEC=1800

# ------------------------------------------------------------------------------
# PROVIDER SELECTION
# ------------------------------------------------------------------------------
WEATHER_PROVIDER=auto
TRAFFIC_PROVIDER=auto
COMPETITION_PROVIDER=auto
EVENT_PROVIDER=auto
ROUTING_PROVIDER=auto
FUEL_PRICE_PROVIDER=manual

# ------------------------------------------------------------------------------
# WEATHER
# ------------------------------------------------------------------------------
# Open-Meteo free API requires no key for non-commercial use (default fallback).
# Current weather + hourly forecast supported.
WEATHER_CACHE_TTL_SEC=300

# Provider: OpenWeatherMap (https://home.openweathermap.org/api_keys)
# Free tier: 60 calls/min, 1,000,000 calls/month (Current Weather API)
# Adds: feels-like temperature, UV index, rain probability, weather alerts
# Steps: openweathermap.org → Sign Up → API Keys tab → Copy Default key
OPENWEATHER_API_KEY=                    # 32-char hex string, e.g. 257c04c0...54d

# ------------------------------------------------------------------------------
# TRAFFIC (Optional)
# ------------------------------------------------------------------------------
# Provider: HERE Technologies (https://developer.here.com/) - 250k free transactions/mo
HERE_API_KEY=
# Provider: TomTom (https://developer.tomtom.com/) - 2.5k free req/day
TOMTOM_API_KEY=

# ------------------------------------------------------------------------------
# ROUTING / TRAVEL TIME (Optional)
# ------------------------------------------------------------------------------
# Default: OSRM (https://router.project-osrm.org) — free, no key needed.
# Override with self-hosted OSRM instance:
OSRM_URL=http://router.project-osrm.org

# Provider: Google Maps Distance Matrix API — best for Indian road conditions
# Free tier: $200/month credit (~40,000 elements/month free)
# Steps: console.cloud.google.com → New Project → Enable "Distance Matrix API"
#        → Credentials → Create API Key → restrict to Distance Matrix API
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# COMPETITION / PLACES (Optional)
# ------------------------------------------------------------------------------
# Provider: Google Places API (https://console.cloud.google.com/) - $200 free credit/mo
# Note: Same key as GOOGLE_MAPS_API_KEY if you enable both APIs in the same project
GOOGLE_PLACES_API_KEY=
# Provider: Foursquare Places API (https://location.foursquare.com/developer/)
FOURSQUARE_API_KEY=

# Provider: Yelp Fusion API — business review density as foot traffic proxy
# Free tier: 5,000 API calls/day
# Steps: yelp.com/developers → Manage App → Create App → copy API Key
YELP_API_KEY=

# ------------------------------------------------------------------------------
# EVENTS (Optional — priority: PredictHQ > Ticketmaster > Eventbrite > Stochastic)
# ------------------------------------------------------------------------------

# Provider: PredictHQ (https://www.predicthq.com/) — BEST for attendance forecasts
# Free tier: 1,000 events/month (Control Center plan)
# Steps: predicthq.com → Get Started Free → Register → API Credentials → Create Token
PREDICTHQ_API_KEY=

# Provider: Ticketmaster Discovery API (https://developer.ticketmaster.com/)
# Free tier: 5,000 API calls/day — completely free
# Steps: developer.ticketmaster.com → Get Your API Key → Sign in → Create App → Consumer Key
TICKETMASTER_API_KEY=

# Provider: Eventbrite API (https://www.eventbrite.com/platform/api)
# Steps: eventbrite.com → Account → Developer Links → API Keys → Create Key
EVENTBRITE_TOKEN=

# ------------------------------------------------------------------------------
# MAPPING (Optional)
# ------------------------------------------------------------------------------
# Provider: Mapbox (https://account.mapbox.com/) — traffic + routing + map tiles
# Free tier: 100,000 requests/month
# Steps: mapbox.com → Sign Up → Account → Tokens → Create a Token
MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# CACHE TTLs (Seconds)
# ------------------------------------------------------------------------------
TRAFFIC_CACHE_TTL_SEC=120
COMPETITION_CACHE_TTL_SEC=1800
EVENTS_CACHE_TTL_SEC=900
OSM_CACHE_TTL_SEC=86400
FUEL_PRICE_CACHE_TTL_SEC=86400
HOLIDAY_CACHE_TTL_SEC=604800

# ------------------------------------------------------------------------------
# FUEL & ECONOMICS
# ------------------------------------------------------------------------------
FUEL_PRICE_INR_PER_LITRE=95.0
FUEL_PRICE_SOURCE=manual_fallback
FUEL_PRICE_EFFECTIVE_DATE=2026-08-18
FUEL_EFFICIENCY_KM_PER_L=18.0

# ------------------------------------------------------------------------------
# SPATIAL & RECOMMENDATION DEFAULTS
# ------------------------------------------------------------------------------
SEARCH_RADIUS_KM=2.0
TOP_N=5
MAX_CANDIDATES=50
AVG_URBAN_SPEED_KMH=20.0

# ------------------------------------------------------------------------------
# BUSINESS DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_AOV_INR=100.0
DEFAULT_VARIABLE_COST_RATE=0.38
DEFAULT_FIXED_COST_PER_DAY_INR=500.0

# ------------------------------------------------------------------------------
# STRATEGIC DECISION POLICY THRESHOLDS (INR/hour)
# ------------------------------------------------------------------------------
# Minimum hourly profit improvement required to recommend moving
STAY_THRESHOLD_INR_PER_HOUR=50.0
# Profit improvement threshold for strong move vs marginal consideration
CONSIDER_MOVE_THRESHOLD_INR_PER_HOUR=250.0